# ── Lovelace dashboards in YAML mode ───────────────────────────────────────────────────────────
#
# GENERATED by roles/homeassistant_lovelace from homeassistant_lovelace_dashboards.
# Do not hand-edit: add or remove entries in that registry instead, or the next deploy reverts you.
#
# WHY. In storage mode a dashboard is HA-owned JSON under .storage/, which HA holds in memory and
# rewrites on shutdown — so writing it from Ansible means STOPPING Core first, and an edit made
# while HA runs is silently reverted. In YAML mode the file IS the config: deployed with a plain
# copy, no restart, readable diffs, and comments are possible.
#
# THE TRADE-OFF: YAML mode DISABLES UI EDITING for these dashboards. No drag-and-drop; every change
# is edit → commit → deploy.
#
# TO REVERT one dashboard to UI editing: remove its entry from the registry and restore its
# .storage/lovelace.<name> file from a backup taken before the switch to YAML mode.
#
# NOTE: this file holds the CONTENTS of the lovelace: key, not the key itself —
# `lovelace: !include lovelace.yaml` in configuration.yaml supplies it. Including the key here too
# yields `lovelace: {lovelace: ...}`, which HA rejects as "'lovelace' is an invalid option for
# 'lovelace'"; the config-check gate catches that before any restart.
mode: yaml
# The default dashboard (sidebar "Overview") is read from <config>/ui-lovelace.yaml — a FIXED
# path, not a `filename:` entry, which is a key on `dashboards:` only. A STRATEGY dashboard there
# (one that generates itself from areas and entities) keeps regenerating in YAML mode too, rather
# than freezing as a snapshot.
{% if homeassistant_lovelace_resources | length == 0 %}
resources: []
{% else %}
resources:
    # RESOURCES MUST BE DECLARED HERE IN YAML MODE. In storage mode they are UI-managed
    # (.storage/lovelace_resources); the moment `mode: yaml` is set that store is IGNORED and any
    # resource not listed stops loading — custom cards then render as an error box.
{% endif %}
{% for r in homeassistant_lovelace_resources %}
  - url: {{ r.url }}
    type: {{ r.type }}
{% endfor %}
dashboards:
{% for d in homeassistant_lovelace_dashboards %}
  {{ d.url_path }}:
    mode: yaml
    title: {{ d.title }}
    icon: {{ d.icon }}
    show_in_sidebar: {{ d.show_in_sidebar | default(true) | lower }}
    filename: {{ homeassistant_lovelace_subdir }}/{{ d.file }}
{% endfor %}
