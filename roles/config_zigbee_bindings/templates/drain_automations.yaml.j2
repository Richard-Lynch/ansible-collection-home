# GENERATED by roles/config_zigbee_bindings (action=install) — DO NOT EDIT.
#
# Source of truth: the `zigbee_bindings` declaration in inventory.
# Regenerate: run the role with config_zigbee_bindings_action=install and
#             config_zigbee_bindings_apply=true.
#
# One automation per Zigbee SOURCE device. Each fires on that device's own wake signal and writes
# any declared binding the device does not already have.
#
# WHY A WAKE TRIGGER. A battery remote listens for only a few seconds after a button press.
# Zigbee's parent buffering holds a message for 7.68s (nwkTransactionPersistenceTime) and nothing
# above that layer queues, so a write must COINCIDE with a wake. This triggers on the wake itself,
# which is why pressing the button is all anyone has to do.
#
# THE CONDITION IS THE DISARM. Without the binds_get gate below, this would re-issue a Bind_req on
# every button press for the life of the device: persistent but never convergent, and invisible
# because each individual write looks reasonable.
#
# `mode: single` is load-bearing, not tidiness: "press it a few times" makes concurrent runs the
# NORMAL case, and overlapping bind/read cycles would race.
{% for src, binds in (_czb_by_device | sort(attribute='0')) %}
{% set slug = src | replace(':', '') %}

- id: czb_drain_{{ slug }}
  alias: "[managed:config_zigbee_bindings] Drain Zigbee bindings — {{ src }}"
  description: >-
    Writes the declared binding(s) for {{ src }} when it next wakes.
    Declared: {{ binds | map(attribute='describe') | join(' | ') }}
  mode: single
  max_exceeded: silent
  triggers:
    # The wake signal: any ZHA event from this device. Matched on the IEEE so it survives a rename
    # (device_id is an HA registry UUID and is regenerated when a device is re-paired).
    - trigger: event
      event_type: zha_event
      event_data:
        ieee: "{{ src }}"
  conditions: []
  actions:
    # Read the device's own binding table. The authoritative source: binds_get issues ZDO
    # Mgmt_Bind_req, so this asks the DEVICE, not a cache.
    - action: zha_toolkit.binds_get
      data:
        ieee: "{{ src }}"
        tries: {{ config_zigbee_bindings_tries | int }}
        fail_exception: false
      response_variable: czb_live
    - choose:
{% for b in binds %}
        # {{ b.describe }}
        - conditions:
            # THE DISARM for this binding: write only if the device's table does not already hold
            # it. Compared on the numeric cluster id, because binds_get reports clusters as hex
            # strings ("0x{{ '%04X' | format(b.cluster) }}") while the service takes names
            # ("{{ b.cluster_name }}") -- an un-normalised comparison would never match and this
            # would re-write forever.
            - condition: template
              value_template: >-
                {% raw %}{{ (czb_live.result | default([])) | selectattr('cluster_id', 'defined')
                   | selectattr('cluster_id', 'equalto', {% endraw %}'0x{{ '%04X' | format(b.cluster) }}'{% raw %})
                   | list | length == 0 }}{% endraw %}
          sequence:
            - action: zha_toolkit.bind_ieee
              data:
                ieee: "{{ b.src }}"
                endpoint: {{ b.src_ep }}
                cluster: {{ b.cluster }}
{% if b.group is not none %}
                command_data: {{ b.group }}
{% else %}
                command_data: "{{ b.dst_ieee }}"
                dst_endpoint: {{ b.dst_ep }}
{% endif %}
                tries: {{ config_zigbee_bindings_tries | int }}
                fail_exception: false
{% endfor %}
{% endfor %}
